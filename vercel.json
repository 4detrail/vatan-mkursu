{
  "redirects": [
    { "source": "/egitimler.html", "destination": "/egitimler/", "permanent": true },
    { "source": "/hakkimizda.html", "destination": "/hakkimizda/", "permanent": true },
    { "source": "/iletisim.html", "destination": "/iletisim/", "permanent": true },
    { "source": "/sss.html", "destination": "/sss/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
